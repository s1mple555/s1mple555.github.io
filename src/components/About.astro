---
import { siteConfig } from '../config';
import PlaceholderText from './PlaceholderText.astro';
import SectionHeading from './SectionHeading.astro';
---
<section class="screen" id="about" aria-labelledby="about-title"><div class="container screen-content section-grid">
  <SectionHeading title="关于我" english="About" id="about-title" />
  <div class="about-content">
    <div class="about-paragraphs">{siteConfig.about.map((paragraph, index) => <p class:list={['about-paragraph', { lead: index === 0 }]} aria-label={paragraph ? undefined : '个人介绍待补充'}>{paragraph || <PlaceholderText lines={index === 1 ? 3 : 2} />}</p>)}</div>
    <div class="capabilities">{siteConfig.skills.map((skill) => (
      <div class="capability-slot">
        <article class="capability">
          <h3>{skill.title || <PlaceholderText lines={1} />}</h3>
          <div class="tags">{skill.items.map((item) => <span class:list={{ 'blank-tag': !item }}>{item || <i aria-hidden="true"></i>}</span>)}</div>
        </article>
      </div>
    ))}</div>
  </div>
</div></section>

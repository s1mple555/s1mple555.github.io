---
import { siteConfig } from '../config';
import '../styles/harness.css';
const project = siteConfig.project2;
---
<section class="screen harness-screen" id="project-2" data-nav-group="projects" aria-labelledby="project-2-title">
  <div class="container screen-content harness-board">
    <div class="harness-intro">
      <div class="harness-signature">
        <svg width="38" height="38" viewBox="0 0 38 38" fill="none" aria-hidden="true">
          <rect x="1" y="1" width="36" height="36" rx="11" stroke="currentColor" stroke-opacity=".2" />
          <path d="M13 11H9v16h4m12-16h4v16h-4M16 15l6 4-6 4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <p>个人编程辅助 Agent<span lang="en">Coding agent runtime</span></p>
      </div>
      <div class="section-heading">
        <p class="section-label" lang="en">Project 2</p>
        <h2 id="project-2-title">{project.name.split(' ').map((word, index) => <>{index > 0 && ' '}<span>{word}</span></>)}</h2>
        <div class="section-rule"></div>
      </div>
      <p class="harness-tagline">{project.tagline}</p>
      <p class="harness-summary">{project.summary}</p>
      <ul class="harness-tech" aria-label="项目技术栈">
        {project.technology.map((technology) => <li>{technology}</li>)}
      </ul>
      <div class="harness-actions">
        <a class="button button-primary" href={project.github} target="_blank" rel="noopener noreferrer">在 GitHub 查看源码 <span aria-hidden="true">↗</span></a>
        <span>{project.period}</span>
      </div>
    </div>
    <div class="harness-explorer" data-harness-explorer>
      <div class="harness-tabs" role="tablist" aria-label="查看 E_coder 核心机制">
        {project.features.map((feature, index) => (
          <button type="button" role="tab" id={'harness-tab-' + feature.id} aria-controls={'harness-panel-' + feature.id} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>
            <span>{feature.title}</span><small lang="en">{feature.english}</small>
          </button>
        ))}
      </div>
      <div class="harness-panels">
        {project.features.map((feature, index) => (
          <div class="harness-panel" role="tabpanel" id={'harness-panel-' + feature.id} aria-labelledby={'harness-tab-' + feature.id} tabindex="0" hidden={index !== 0}>
            <div class="harness-visual">
              <div class="harness-visual-top"><span class="harness-file-mark" aria-hidden="true"></span><span>E_coder / {feature.english}</span></div>
              <div class="harness-resume">
                <div class="harness-context-heading"><span>{feature.title}流程</span><span class="harness-state">{feature.english}</span></div>
                <ol class="harness-workflow" aria-label={feature.title + '流程'}>
                  {feature.steps.map((step, stepIndex) => (
                    <li class={stepIndex === 1 ? 'harness-workflow-active' : ''}>
                      <span class="harness-workflow-node" aria-hidden="true">{stepIndex + 1}</span>
                      <div><strong>{step.title}</strong><small>{step.detail}</small></div>
                    </li>
                  ))}
                </ol>
              </div>
            </div>
            <div class="harness-feature-copy">
              <h3>{feature.headline}</h3>
              <p>{feature.description}</p>
              <div class="harness-principle"><span aria-hidden="true"></span><p>{feature.principle}</p></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  const explorer = document.querySelector<HTMLElement>('[data-harness-explorer]');
  const tabs = [...(explorer?.querySelectorAll<HTMLButtonElement>('[role="tab"]') || [])];
  const panels = [...(explorer?.querySelectorAll<HTMLElement>('[role="tabpanel"]') || [])];
  function selectMechanism(index: number, focus = false) {
    if (!tabs[index]) return;
    tabs.forEach((tab, current) => {
      const selected = current === index;
      tab.setAttribute('aria-selected', String(selected));
      tab.tabIndex = selected ? 0 : -1;
      if (panels[current]) panels[current].hidden = !selected;
    });
    if (focus) tabs[index].focus({ preventScroll: true });
  }
  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => selectMechanism(index));
    tab.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault();
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length;
      selectMechanism(next, true);
    });
  });
</script>

---
import { siteConfig, asset } from '../config';
import Header from '../components/Header.astro';
import { getHeroImage } from '../lib/hero-image';
import '../styles/fonts.css';
import '../styles/global.css';
import fontRegular from '../assets/fonts/ibm-plex-mono/ibm-plex-mono-latin-400-normal.woff2?url';
import fontBold from '../assets/fonts/ibm-plex-mono/ibm-plex-mono-latin-700-normal.woff2?url';
interface Props { title?: string; description?: string; page?: 'home' | 'posts'; }
const defaultTitle = siteConfig.name ? siteConfig.name + ' | ' + siteConfig.role : siteConfig.role + ' | 个人作品集';
const { title = defaultTitle, description = siteConfig.description, page = 'home' } = Astro.props;
const heroImage = page === 'home' ? await getHeroImage() : null;
---
<!doctype html>
<html lang="zh-CN" data-page={page}><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" /><meta name="generator" content={Astro.generator} /><meta name="description" content={description} /><meta name="theme-color" content="#ffffff" /><meta property="og:type" content="website" /><meta property="og:locale" content="zh_CN" /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} /><link rel="preload" href={fontRegular} as="font" type="font/woff2" crossorigin="anonymous" /><link rel="preload" href={fontBold} as="font" type="font/woff2" crossorigin="anonymous" />{heroImage && <link rel="preload" as="image" href={heroImage.src} imagesrcset={heroImage.srcSet.attribute} imagesizes={heroImage.attributes.sizes} type="image/webp" fetchpriority="high" />}<title>{title}</title></head><body><a href="#main-content" class="skip-link">跳转到主要内容</a><Header page={page} /><main id="main-content"><slot /></main></body></html>

---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../styles/posts.css';
import ReadingFooter from '../../components/ReadingFooter.astro';
import { asset } from '../../config';
import { getPublishedPosts, formatPostDate, type PublishedPost } from '../../lib/posts';
export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}) satisfies GetStaticPaths;
interface Props { post: PublishedPost; }
const { post } = Astro.props;
const { Content, headings } = await render(post.entry);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
---
<BaseLayout page="posts" title={post.title + ' | 帖子 / Posts'} description={post.description}>
  <div class="article-shell container">
    <a class="article-back" href={asset('posts/')}>← 帖子 <span lang="en">/ Posts</span></a>
    <header class="article-header"><p class="section-label" lang="en">Post</p><h1>{post.title}</h1><div class="article-meta">{post.date && <time datetime={post.date.toISOString()}>{formatPostDate(post.date)}</time>}{post.updated && <span>更新 / Updated {formatPostDate(post.updated)}</span>}<span class="post-category">{post.category}</span>{post.tags.length > 0 && <ul class="post-tags" aria-label="标签">{post.tags.map((tag) => <li>{tag}</li>)}</ul>}</div></header>
    <div class:list={['article-grid', { 'has-toc': toc.length > 0 }]}><article class:list={['post-body', { 'has-leading-title': post.hasLeadingTitle }]}><Content /></article>{toc.length > 0 && <aside class="article-sidebar"><details class="article-toc" open><summary>目录 <span lang="en">/ Contents</span></summary><ol>{toc.map((heading) => <li class:list={{ 'toc-nested': heading.depth === 3 }}><a href={'#' + heading.slug}>{heading.text}</a></li>)}</ol></details></aside>}</div>
    <a class="article-end-link" href={asset('posts/')}>← 返回帖子 <span lang="en">/ Back to posts</span></a>
    <ReadingFooter />
  </div>
</BaseLayout>

---
import PostsList from '../../components/PostsList.astro';
import { getPostSummaries } from '../../lib/posts';
import { POSTS_PER_PAGE } from '../../lib/post-settings';
const posts = await getPostSummaries();
---
<PostsList posts={posts.slice(0, POSTS_PER_PAGE)} currentPage={1} totalPosts={posts.length} />
